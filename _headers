# ---------------------------------------------------------------------------
# TRUE — Cabeceras de seguridad para producción (Netlify / Cloudflare Pages).
# Defensa en profundidad: CSP estricta, anti-framing, anti-MIME-sniffing,
# aislamiento cross-origin y política de permisos restrictiva.
# ---------------------------------------------------------------------------
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://challenges.cloudflare.com https://pagead2.googlesyndication.com https://api.open-meteo.com https://api.frankfurter.app https://api.coingecko.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none

# NOTA: si Google AdSense exige `unsafe-inline` en script-src para sus propios
# scripts de relleno, sustituya la directiva por nonces generados en el edge
# (Google recomienda `nonce-<valor>`), nunca relaje `default-src`.

# El shell de la app nunca se cachea en duro: siempre revalida.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Assets con hash inmutable: cache agresivo para sobrevivir a picos de tráfico.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker: debe revalidarse siempre.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800

# El manifiesto PWA y los recursos de arranque también deben revalidarse.
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

# Arranque de tema: si cambia, debe llegar de inmediato (evita un destello
# con la paleta anterior durante 4 días de caché).
/theme-boot.js
  Cache-Control: public, max-age=0, must-revalidate

/offline.html
  Cache-Control: public, max-age=0, must-revalidate
